rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "admin@bdj.com";
    }

    // ── Private user doc ─────────────────────────────────────────────
    match /users/{userId} {
      // Owner or admin can read the full private doc
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());
      // New user creates their own doc on first sign-in
      allow create: if request.auth != null && request.auth.uid == userId;
      // Owner can update own doc, but cannot modify points or team
      allow update: if request.auth != null && 
                    ((request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'team'])) 
                     || isAdmin());

      // ── Points Log ──────────────────────────────────────────────────
      match /pointsLog/{logId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && isAdmin();
      }
    }

    // ── Public sub-doc ────────────────────────────────────────────────
    match /users/{userId}/public/profile {
      // Any authenticated user can read public profiles
      allow read: if request.auth != null;
      // Only the owner can write their own public profile
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(['username', 'photoURL']);
    }

    // Collection group rule for public profile subcollections
    match /{path=**}/public/{docId} {
      allow read: if request.auth != null;
    }

    // ── Attendance ────────────────────────────────────────────────────
    match /attendance/{docId} {
      allow read:   if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
    }

    // ── Posts ─────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // ── Events + Registrations ────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();

      // Event Registrations:
      match /registrations/{userId} {
        allow read: if true;
        allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow update: if request.auth != null && isAdmin();
      }
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow create: if request.auth != null && isAdmin();
      allow read, update: if request.auth != null &&
        request.auth.uid == resource.data.toUid;
    }

    // ── Board Members ─────────────────────────────────────────────────
    match /boardMembers/{memberId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
